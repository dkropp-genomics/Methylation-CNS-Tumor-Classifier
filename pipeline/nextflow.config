// Settings for pipeline/main.nf (local executor, CPU only).
//
// Every step is one of the repository's own scripts, run from the repository
// root. The scripts write to data/ and results/ and resume by themselves, so
// Nextflow's task cache is switched off: rerunning the same command continues
// where the last run stopped.

params {
    repo    = "${projectDir}/.."              // the repository root
    python  = 'conda run --no-capture-output -n methyl-py python'
    rscript = 'conda run --no-capture-output -n methyl-r Rscript'
    workers = 6                               // physical cores for download checks and SeSAMe
}

// The profile name decides what runs (main.nf reads it); the default is quick.
profiles {
    quick { env.METHYL_PROFILE = 'quick' }    // selected settings only: external cohort and SHAP
    full  { env.METHYL_PROFILE = 'full' }     // everything, including the searches (about 20 h)
}

process {
    executor      = 'local'
    maxForks      = 1                         // one step at a time: steps use every core and up to 18 GB
    cache         = false
    errorStrategy = 'terminate'
}

workDir = "${projectDir}/../data/nextflow_work"   // under data/, which Git ignores

timeline { enabled = true; overwrite = true; file = "${projectDir}/../logs/pipeline_timeline.html" }
trace    { enabled = true; overwrite = true; file = "${projectDir}/../logs/pipeline_trace.tsv" }
